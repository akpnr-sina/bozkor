# Copy to .env.local and fill in. Never commit real values.

# --- App ---
# Public base URL; used for magic link redirects. Must be in Supabase Auth > URL Configuration.
APP_URL=http://localhost:3000
# Comma-separated; only these addresses can sign in.
ALLOWED_EMAILS=ad.soyad@bozkor.com,ikinci.kisi@bozkor.com

# --- Supabase (EU region) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server and worker only (Storage, Phase 5).
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tender-documents
# Session pooler (port 5432) or direct connection. pg-boss needs session mode;
# the transaction pooler (port 6543) does not support LISTEN/NOTIFY.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- LLM (Phase 4+) ---
ANTHROPIC_API_KEY=
LLM_TRIAGE_MODEL=claude-haiku-5-5
LLM_ANALYSIS_MODEL=claude-sonnet-5-5
# Automatic analyses stop once monthly spend reaches this; manual runs still work with a warning.
LLM_MONTHLY_BUDGET_USD=100

# --- Email digest (Phase 7) ---
RESEND_API_KEY=
DIGEST_EMAIL_FROM=Bozkor Ihale <ihale@bozkor.com>
DIGEST_EMAIL_TO=rfq@bozkor.com
